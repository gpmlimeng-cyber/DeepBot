# ============================================================================
# DeepBot 构建依赖锁定（唯一来源）
#
# 本文件只回答一个问题：这次构建用的引擎和 ds-bot 分别是哪一版。
# 修改这里就等于改构建，改完必须重新出包并记录 sha256。
# ============================================================================

# --- 1. 引擎：官方上游，按版本锁定 -------------------------------------------
# 发布源：npm registry（@deepseek-ai/dsh）
# 为什么锁 sha512：npm 的 version 可被重发覆盖，integrity 是唯一稳定指纹。
ENGINE_NAME="@deepseek-ai/dsh"
ENGINE_VERSION="0.2.1-rc.2"
ENGINE_INTEGRITY="sha512-tvY+yhfKRifthbqPe/OK0AYxM5ZkvqfYq/jMYgJcEUxiRRL1Vwra3Ti5TB6AXgSWQdiPHYh/Vp6SJa9yHwMNuw=="
ENGINE_SHASUM="a502d1551aabc881020e3cb7961c38901565731a"

# --- 2. 引擎运行时：本仓库脚本从 Termux 仓库 + 上面的引擎版本组装 -------------
# 产物：android/app/src/main/assets/runtime.zip（不入库）
# 构建：./runtime/collect-termux-runtime.sh <输出zip> aarch64
# 该脚本内含全部安卓侧补丁（koffi/node-pty 桩、flock、apiproxy、webview-polyfill、
# require-builtin 回退、rgPath 前缀改写、collapsedWidth=0），清单不在文档里另抄。
# 当前产物：sha256 8a5eb37f4ccdc21517adeec727814fb6864bd59ee0ed0e8c669e6b052ce663eb
RUNTIME_ASSET_SHA256="8a5eb37f4ccdc21517adeec727814fb6864bd59ee0ed0e8c669e6b052ce663eb"

# --- 3. ds-bot：我们自己的二开仓库，按 commit 锁定 ----------------------------
# 不存 zip、不存快照：构建时按这个 commit 现取现打，仓库里不留死文件。
DSBOT_REPO="https://github.com/gpmlimeng-cyber/dsh-bot"
DSBOT_REF="c30adfc52a9b45a1e11d874bb7e30b7f89d46456"
DSBOT_SUBDIR="ds-bot"
