<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.2.121 首屏（启动页）：先于 WebView 渲染，保证点图标后 ~1s 内有可看的界面。
  进度条用不确定动画（不造假进度）；状态文案绑定真实引擎状态：
    Starting → 正在启动本地引擎… Ns
    Installing → 正在安装运行时 NN%
    Healthy → 就绪（随后淡出）
    Failed → 错误原因 + 重试
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/splash_bg"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/splashMark"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginBottom="18dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_deepbot_mark" />

    <TextView
        android:id="@+id/splashName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/splash_text"
        android:textSize="26sp"
        android:letterSpacing="0.12"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/splashSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/splash_tagline"
        android:textColor="@color/splash_text_dim"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/splashSpinner"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="30dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/ds_accent" />

    <TextView
        android:id="@+id/splashStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingHorizontal="32dp"
        android:gravity="center"
        android:text="@string/splash_starting_engine"
        android:textColor="@color/splash_text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/splashErrorGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="36dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/splashError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/splash_error"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/splashRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingHorizontal="26dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_btn_accent"
            android:text="@string/splash_retry"
            android:textColor="@color/ds_on_accent"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
