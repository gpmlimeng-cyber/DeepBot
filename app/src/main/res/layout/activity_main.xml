<?xml version="1.0" encoding="utf-8"?>
<!--
  根布局（v1.2.121）：首帧只渲染启动页。
  主内容（WebView + 工具栏）放在 ViewStub 里，等启动页画出第一帧后再 inflate，
  这样 WebView 初始化不会卡在 setContentView 里（冷启动首帧 < 1s 的关键）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewStub
        android:id="@+id/mainContentStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_main_content" />

    <include layout="@layout/view_splash" />
</FrameLayout>
