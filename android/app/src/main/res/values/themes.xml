<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      壳的主题定义（v1.2.121 起支持浅色/深色两套）。
      所有颜色都走 @color/ds_*，由 values-night/colors.xml 提供深色档；
      Activity 在 attachBaseContext 里按用户偏好覆盖 uiMode（ThemeHelper），
      因此「跟随系统 / 浅色 / 深色」三档都能落到同一套资源上。
    -->
    <style name="Theme.Dsh" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/ds_bg_base</item>
        <item name="android:navigationBarColor">@color/ds_bg_base</item>
        <item name="android:windowBackground">@color/ds_bg_base</item>
        <!-- 浅色档状态栏用深色图标；深色档在 values-night/themes.xml 里覆盖为 false -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- v1.2.45：全部 AlertDialog 统一圆角皮肤，颜色随主题走 -->
        <item name="android:alertDialogTheme">@style/Theme.Dsh.Dialog</item>
    </style>

    <!-- v1.2.79：Spinner 下拉弹框不再是框架默认白底；背景/文字都随主题 -->
    <style name="Theme.Dsh.Spinner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:popupBackground">@drawable/bg_menu_card</item>
        <item name="android:textColorPrimary">@color/ds_text_strong</item>
        <item name="android:textColorSecondary">@color/ds_text_tertiary</item>
        <item name="android:colorAccent">@color/ds_accent</item>
        <item name="android:textColor">@color/ds_text_primary</item>
    </style>

    <style name="Theme.Dsh.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:colorAccent">@color/ds_accent</item>
        <item name="android:textColorPrimary">@color/ds_text_strong</item>
        <item name="android:textColorSecondary">@color/ds_text_tertiary</item>
    </style>
</resources>
